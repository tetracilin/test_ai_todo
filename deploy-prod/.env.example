# K18 production — names only. Put real values in deploy-prod/runtime.env
# (used via `docker compose --env-file`) and deploy-prod/secrets/*;
# never commit any of them.
COMPOSE_PROJECT_NAME=t3-prod
PAPERCLIP_IMAGE=paperclip:k15-7927f06fa
POSTGRES_IMAGE=postgres:17.9-alpine@sha256:c7526c0f6c3f30260a563d7bcf8ad778effac59a44f8ffa86678c35418338609
PAPERCLIP_BIND_ADDRESS=0.0.0.0
PAPERCLIP_PORT=3100
PAPERCLIP_PUBLIC_URL=http://127.0.0.1:3100
PAPERCLIP_ALLOWED_HOSTNAMES=localhost,127.0.0.1,100.103.41.112,hostinger-kvm8-host,hostinger-kvm8-host.tail9831b.ts.net
HERMES_API_BASE_URL=http://host.docker.internal:8642
HERMES_BRIDGE_IP=172.21.0.1
HERMES_BRIDGE_SUBNET=172.21.0.0/24
POSTGRES_USER=paperclip
POSTGRES_DB=paperclip
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
BETTER_AUTH_SECRET_FILE=./secrets/better_auth_secret
PAPERCLIP_BUILD_VERSION=production-k18
# S3 storage backend (minio on tailnet) — same as pre-cutover production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
