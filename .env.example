DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=paperclip-dev-tool-action-signing-secret-change-me

# Process-wide protection for expensive full-tree workspace Git scans.
# PAPERCLIP_WORKSPACE_GIT_SCAN_CONCURRENCY=2
# PAPERCLIP_WORKSPACE_GIT_SCAN_QUEUE_CAPACITY=32
# PAPERCLIP_WORKSPACE_GIT_SCAN_TIMEOUT_MS=8000
# PAPERCLIP_WORKSPACE_GIT_SCAN_CACHE_TTL_MS=10000

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Teable (F-010-1). Production Teable is a self-hosted container on the app host,
# so the default base URL is the sibling compose service, not Teable Cloud.
# The API token is NOT read from here: it is a company secret named
# TEABLE_API_TOKEN (reads prefer a read-only TEABLE_READ_TOKEN when one exists).
# PAPERCLIP_TEABLE_BASE_URL=http://teable:3000
# Required for any private-network host other than the default above.
# PAPERCLIP_TEABLE_ALLOW_PRIVATE_NETWORK=1
# PAPERCLIP_TEABLE_REQUEST_TIMEOUT_MS=15000
# PAPERCLIP_TEABLE_MAX_ATTEMPTS=3

# Teable agent write (F-010-2, Slice-1 append-only subset). Two more company secrets, not env
# vars: TEABLE_WRITE_TABLE_ID (the one Teable table the agent may create rows in) and
# TEABLE_BOT_ACCOUNT_NAME (the Teable user account the write token belongs to -- must be a
# dedicated bot account, so F-005-1's conflict flagging never fires on the bot's own writes).
# Browser-facing Teable origin, separate from PAPERCLIP_TEABLE_BASE_URL above (that one is
# server-to-server only and meaningless in a browser). Optional -- unset means every Teable
# evidence row gets url: null instead of a link.
# PAPERCLIP_TEABLE_PUBLIC_URL=https://teable.paperclip.local
