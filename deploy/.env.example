# Names only. Put real values in deploy/.env and deploy/secrets/*; never commit either.
COMPOSE_PROJECT_NAME=
PAPERCLIP_IMAGE=
POSTGRES_IMAGE=
PAPERCLIP_BIND_ADDRESS=
PAPERCLIP_PORT=
PAPERCLIP_PUBLIC_URL=
PAPERCLIP_ALLOWED_HOSTNAMES=
HERMES_API_BASE_URL=
PAPERCLIP_SELECTABLE_ADAPTER_TYPES=
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD_FILE=
BETTER_AUTH_SECRET_FILE=
PAPERCLIP_ARTIFACTS_ACCESS_KEY_FILE=
PAPERCLIP_ARTIFACTS_SECRET_KEY_FILE=

# External artifact storage (NAS MinIO) — the additive second source the
# artifact picker offers next to internal storage. This deployment configures
# it in paperclip-config.json (storage.external); the variables below are the
# env equivalents, which win over the file when set.
#
# They are NOT forwarded by compose.yaml today, so setting them in deploy/.env
# alone changes nothing — reaching the container needs an environment: entry in
# the paperclip service, which is a pipeline change (separate, ci-labelled PR).
#
# endpoint and bucket must BOTH be set or the external source stays undefined.
# The two secret refs are secret NAMES, never values, and must be set together
# or neither — one alone makes the provider throw at startup.
#PAPERCLIP_STORAGE_EXTERNAL_ENDPOINT=http://nas-storage-t19.tail9831b.ts.net:9000
#PAPERCLIP_STORAGE_EXTERNAL_BUCKET=paperclip-artifacts
#PAPERCLIP_STORAGE_EXTERNAL_REGION=us-east-1
#PAPERCLIP_STORAGE_EXTERNAL_PREFIX=
#PAPERCLIP_STORAGE_EXTERNAL_FORCE_PATH_STYLE=true
#PAPERCLIP_STORAGE_EXTERNAL_ACCESS_KEY_SECRET_REF=paperclip_artifacts_access_key
#PAPERCLIP_STORAGE_EXTERNAL_SECRET_KEY_SECRET_REF=paperclip_artifacts_secret_key
