# Discord application credentials (Discord Developer Portal -> your app)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional: restrict slash command registration to one guild for instant propagation during dev.
# Omit for a global command deploy (takes up to ~1h to propagate).
DISCORD_DEV_GUILD_ID=

# Paperclip API
PAPERCLIP_API_URL=http://localhost:3100
# Bridge-scoped key. It must be authorized only for /api/integrations/discord/*.
PAPERCLIP_API_KEY=

# Durable outbox poll interval, in seconds.
POLL_INTERVAL_SECONDS=30
