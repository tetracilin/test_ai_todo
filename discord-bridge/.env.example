# Local development only. Copy to .env and supply development credentials.
# Never commit .env or replace these placeholders with production values.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_WEBHOOK_SECRET=

# Optional: registers commands in one development guild. Omit for global commands.
# DISCORD_DEV_GUILD_ID=

# Bridge-scoped Paperclip credential. It must be authorized only for
# /api/integrations/discord/*.
PAPERCLIP_API_URL=http://127.0.0.1:3100
PAPERCLIP_API_KEY=
POLL_INTERVAL_SECONDS=30

# Production: leave secret values unset and point each *_FILE variable at a
# mounted Docker/host/secret-manager file instead. *_FILE takes effect when its
# matching direct variable is empty or absent.
# DISCORD_BOT_TOKEN_FILE=/run/secrets/discord_bot_token
# DISCORD_CLIENT_ID_FILE=/run/secrets/discord_client_id
# DISCORD_WEBHOOK_SECRET_FILE=/run/secrets/discord_webhook_secret
# DISCORD_DEV_GUILD_ID_FILE=/run/secrets/discord_dev_guild_id
# PAPERCLIP_API_KEY_FILE=/run/secrets/paperclip_discord_bridge_token

# Loopback readiness endpoint used by container health checks.
HEALTH_PORT=8080