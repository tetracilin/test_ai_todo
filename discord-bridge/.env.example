# Discord application credentials (Discord Developer Portal -> your app)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional: restrict slash command registration to one guild for instant propagation during dev.
# Omit for a global command deploy (takes up to ~1h to propagate).
DISCORD_DEV_GUILD_ID=

# Paperclip API
PAPERCLIP_API_URL=http://localhost:3100
PAPERCLIP_COMPANY_ID=
# Long-lived key for this bridge's own Paperclip agent identity.
# Mint with: POST /api/agents/:agentId/keys (see README "Setup").
PAPERCLIP_API_KEY=
# Prefix used to build issue links, e.g. "T" for T-10 -> /T/issues/T-10
PAPERCLIP_ISSUE_PREFIX=T
# Base URL of the Paperclip dashboard, for links posted into Discord. Defaults to PAPERCLIP_API_URL.
PAPERCLIP_DASHBOARD_URL=

# Path to the bridge's local link-store file (Discord user <-> Paperclip user mapping).
# This is bridge-owned state, not a Paperclip schema change.
BRIDGE_DB_PATH=./data/bridge-store.json

# Inbound-notification poll interval, in seconds.
POLL_INTERVAL_SECONDS=30
