# Node.js project .gitignore

# Dependency directories
node_modules/
bower_components/

# Build artifacts
/dist
/build
/out
packages/*/dist/
packages/*/*/dist/
server/dist/
ui/dist/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript
*.tsbuildinfo

# Mac OS
.DS_Store

# Windows
Thumbs.db

# Linux
*~

# Test coverage
/coverage

# Local development
/debug
/local

# IDE specific
/.idea
/.vscode

# Project specific
/scratch
/temp
