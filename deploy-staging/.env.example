# K16 staging — names only. Put real values in deploy-staging/.env and
# deploy-staging/secrets/*; never commit either.
COMPOSE_PROJECT_NAME=t3-staging
PAPERCLIP_IMAGE=paperclip:k15-7927f06fa
POSTGRES_IMAGE=
PAPERCLIP_BIND_ADDRESS=127.0.0.1
PAPERCLIP_PORT=33120
PAPERCLIP_PUBLIC_URL=http://127.0.0.1:33120
PAPERCLIP_ALLOWED_HOSTNAMES=localhost,127.0.0.1
HERMES_API_BASE_URL=http://host.docker.internal:8642
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD_FILE=
BETTER_AUTH_SECRET_FILE=
PAPERCLIP_WOPI_STAGING_ENABLED=false
PAPERCLIP_WOPI_EDITOR_ORIGIN=https://hostinger-kvm8-host.tail9831b.ts.net:8444
PAPERCLIP_WOPI_CALLBACK_ORIGIN=
PAPERCLIP_STORAGE_EXTERNAL_LABEL=NAS MinIO
PAPERCLIP_STORAGE_EXTERNAL_ENDPOINT=
PAPERCLIP_STORAGE_EXTERNAL_REGION=us-east-1
PAPERCLIP_STORAGE_EXTERNAL_BUCKET=
PAPERCLIP_STORAGE_EXTERNAL_PREFIX=external/
PAPERCLIP_STORAGE_EXTERNAL_FORCE_PATH_STYLE=true
PAPERCLIP_STORAGE_EXTERNAL_ACCESS_KEY_SECRET_REF=paperclip_artifacts_access_key
PAPERCLIP_STORAGE_EXTERNAL_SECRET_KEY_SECRET_REF=paperclip_artifacts_secret_key
PAPERCLIP_ARTIFACTS_ACCESS_KEY_FILE=
PAPERCLIP_ARTIFACTS_SECRET_KEY_FILE=

# Discord bridge secrets: provision each file outside git with mode 0600.
# Compose mounts them into the bridge at /run/secrets/<name>.
DISCORD_BOT_TOKEN_FILE=./secrets/discord_bot_token
DISCORD_CLIENT_ID_FILE=./secrets/discord_client_id
DISCORD_WEBHOOK_SECRET_FILE=./secrets/discord_webhook_secret
PAPERCLIP_DISCORD_BRIDGE_TOKEN_FILE=./secrets/paperclip_discord_bridge_token

# Public URL used by the bridge to call staging Paperclip. This value is not a secret.
DISCORD_PAPERCLIP_API_URL=http://host.docker.internal:33120
# Optional: instant slash-command registration in an isolated staging guild.
# DISCORD_DEV_GUILD_ID=
# Discord bridge runtime options.
PAPERCLIP_DISCORD_BRIDGE_IMAGE=
DISCORD_POLL_INTERVAL_SECONDS=
# Optional: restrict slash-command registration to one staging guild.
# DISCORD_DEV_GUILD_ID_FILE=./secrets/discord_dev_guild_id